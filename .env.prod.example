# ============================================================
#  Sentinel — PRODUCTION konfiguratsiyasi
#  Nusxa oling:  cp .env.prod.example .env.prod
#  Keyin quyidagilarni ALBATTA almashtiring:
#    POSTGRES_PASSWORD, JWT_SECRET_KEY, SUPERADMIN_PASSWORD
# ============================================================

ENV=prod

# --- Tashqi port (nginx shu portда tinglaydi) ---
WEB_PORT=8090

# --- Proksi (internetsiz VM: Squid orqali) ---------------------------------
# Internetli mashinada BO'SH qoldiring. Internetsiz VM'da to'ldiring —
# `docker compose -f docker-compose.prod.yml build` vaqtида apt/pip/npm shu
# orqali chiqadi. Docker demoni uchun alohida: deploy/PROKSI-VA-VM.md.
# NO_PROXY ga ichki hostlarni (db, backend, web) qo'shing.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1,db,backend,web

# --- PostgreSQL ---
POSTGRES_USER=soc
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=soc_platform
# db host = 'db' (compose tarmog'i ichida). Compose buni qayta yozadi, lekin
# backend env_file ham o'qiydi:
DATABASE_URL=postgresql+asyncpg://soc:CHANGE_ME_strong_db_password@db:5432/soc_platform

# --- JWT ---  ( openssl rand -hex 32 )
JWT_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- HTTPS (ixtiyoriy — docker-compose.tls.yml bilan) ---------------------
# DOMEN kiritsangiz: `docker compose -f docker-compose.prod.yml -f docker-compose.tls.yml ...`
# Caddy konteyneri 80/443 da avtomatik Let's Encrypt sertifikat oladi.
# Shart: DNS'da DOMAIN -> VM IP (A yozuv), 80 va 443 portlari ochiq.
# HTTPS yoqसангиз COOKIE_SECURE=true qiling (pastda).
DOMAIN=

# --- Refresh token cookie ---
# :8090 oddiy HTTP orqali ochilsa -> false.
# HTTPS (docker-compose.tls.yml / tashqi TLS) qo'ysangiz -> true.
REFRESH_COOKIE_NAME=sd_refresh_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_PATH=/api/auth

# --- Login urinishlar limiti ---
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15

# --- Parol siyosati ---
PASSWORD_MIN_LENGTH=10

# --- Xavfsizlik header'lari / HSTS (HSTS faqat prod + COOKIE_SECURE=true da) ---
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=63072000

# --- Fon tozalash (retention) ---
CLEANUP_INTERVAL_HOURS=24
REFRESH_TOKEN_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=180

# --- Super admin seed (birinchi ishga tushishда yaratiladi) ---
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=CHANGE_ME_S3cure_pass!

# --- CORS: bitta origin (nginx). LAN/domen bo'lsa o'zgartiring. ---
CORS_ORIGINS=http://localhost:8090

# --- Frontend build (nisbiy — bitta origin ortida) ---
VITE_API_BASE_URL=/api
