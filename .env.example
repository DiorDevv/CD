# ============================================================
#  SOC/DLP Monitoring Platform — namuna konfiguratsiya
#  Nusxa oling:  cp .env.example .env
# ============================================================

# --- Muhit ---
ENV=dev

# --- Proksi (internetsiz VM: Squid orqali) ---------------------------------
# Odatiy (internetli) mashinada BO'SH qoldiring.
# Internetsiz VM'da to'ldiring — bu qiymatlar `docker compose build` vaqtida
# backend/frontend image'lariga (apt/pip/npm) beriladi.
#   * Docker demoni base image'larni tortishi uchun ALOHIDA sozlanadi:
#     /etc/systemd/system/docker.service.d/http-proxy.conf  (deploy/PROKSI-VA-VM.md)
#   * NO_PROXY ga ichki compose hostlarini (db, backend, web) qo'shish SHART —
#     aks holda backend bazaga ham proksi orqali ulanmoqchi bo'ladi.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1,db,backend,web,frontend

# --- Host portlari (band bo'lsa o'zgartiring) ---
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- PostgreSQL (docker-compose 'db' xizmati uchun) ---
POSTGRES_USER=soc
POSTGRES_PASSWORD=soc
POSTGRES_DB=soc_platform

# Backend ulanish satri (docker ichida host = 'db').
# Lokal ishga tushirsangiz: postgresql+asyncpg://soc:soc@localhost:5432/soc_platform
DATABASE_URL=postgresql+asyncpg://soc:soc@db:5432/soc_platform

# --- JWT ---
# Ishlab chiqarishda albatta almashtiring:  openssl rand -hex 32
JWT_SECRET_KEY=super-secret-change-me-0000000000000000000000000000
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Refresh token cookie ---
REFRESH_COOKIE_NAME=sd_refresh_token
# prod (HTTPS) -> true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_PATH=/api/auth

# --- Login urinishlar limiti ---
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15

# --- Parol siyosati ---
PASSWORD_MIN_LENGTH=10

# --- Xavfsizlik header'lari / HSTS ---
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=63072000

# --- Fon tozalash (retention) ---
CLEANUP_INTERVAL_HOURS=24
REFRESH_TOKEN_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=180

# --- Super admin seed (scripts/seed_superadmin.py o'qiydi) ---
# Parol siyosatiga mos bo'lishi shart (min 10, katta+kichik harf, raqam).
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=ChangeMe_S3cure!

# --- CORS (frontend origin) ---
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api
